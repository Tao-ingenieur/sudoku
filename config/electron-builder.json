{
  "appId": "com.sudokuacademy.app",
  "productName": "Sudoku Academy",
  "copyright": "Copyright \u00a9 2026 Sudoku Academy",
  "directories": {
    "output": ".build/windows"
  },
  "files": [
    ".build/web/**/*",
    "platforms/desktop/main.js",
    "package.json",
    "LICENSE",
    "docs/THIRD_PARTY_NOTICES.md"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": ".build/icon.ico",
    "artifactName": "Sudoku-Academy-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sudoku Academy",
    "artifactName": "Sudoku-Academy-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Sudoku-Academy-Portable-${version}.${ext}"
  }
}
