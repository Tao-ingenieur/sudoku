page {
  background: #f2f5f7;
  color: #172029;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
view, text, button, input, textarea, scroll-view, picker {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0;
  line-height: normal;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}
