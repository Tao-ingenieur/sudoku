.page {
  --bg: #f2f5f7;
  --surface: #ffffff;
  --surface-2: #f7f9fa;
  --surface-3: #eef2f4;
  --text: #172029;
  --text-soft: #34414d;
  --muted: #6c7884;
  --faint: #9aa5af;
  --line: #dbe1e7;
  --line-strong: #34414d;
  --cell-line: #d5dde4;
  --accent: #0f766e;
  --accent-strong: #0b5f58;
  --accent-ink: #0b5f58;
  --accent-soft: #d8f3ef;
  --accent-border: #92ddd2;
  --outline-border: #9ed8d0;
  --cell: #ffffff;
  --given: #eef1f4;
  --given-text: #1c2630;
  --peer: #f2f7f8;
  --same: #e4f4f2;
  --selected: #cceee9;
  --unit: #f2f7fd;
  --blue: #2563eb;
  --blue-soft: #eff6ff;
  --blue-border: #bfdbfe;
  --violet: #a21caf;
  --violet-soft: #fdf4ff;
  --red: #dc2626;
  --red-soft: #fee2e2;
  --red-weak: #fde5e5;
  --red-pale: #fef2f2;
  --amber: #b45309;
  --amber-soft: #fef3c7;
  --green: #047857;
  --green-soft: #d1fae5;
  --green-pale: #ecfdf5;
  --track: #b8c2cc;
  --overlay: rgba(9, 14, 18, .55);
  --shadow: rgba(23, 32, 41, .13);
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
  background: var(--bg);
  color: var(--text);
}
.page.theme-dark {
  --bg: #0c1116;
  --surface: #151d24;
  --surface-2: #1a232b;
  --surface-3: #202b34;
  --text: #e8eef3;
  --text-soft: #cad3db;
  --muted: #93a0ac;
  --faint: #6f7d89;
  --line: #2b3741;
  --line-strong: #b7c3cc;
  --cell-line: #32404b;
  --accent: #2dd4bf;
  --accent-strong: #14b8a6;
  --accent-ink: #5eead4;
  --accent-soft: rgba(45, 212, 191, .14);
  --accent-border: #2b7f74;
  --outline-border: #357f74;
  --cell: #151d24;
  --given: #202a33;
  --given-text: #eef4f8;
  --peer: #19242c;
  --same: #173631;
  --selected: #194a47;
  --unit: #1a2931;
  --blue: #60a5fa;
  --blue-soft: rgba(96, 165, 250, .16);
  --blue-border: #3b6595;
  --violet: #e879f9;
  --violet-soft: rgba(232, 121, 249, .14);
  --red: #f87171;
  --red-soft: rgba(248, 113, 113, .16);
  --red-weak: #3b2222;
  --red-pale: #2b1b1b;
  --amber: #fbbf24;
  --amber-soft: rgba(251, 191, 36, .13);
  --green: #34d399;
  --green-soft: rgba(52, 211, 153, .14);
  --green-pale: rgba(52, 211, 153, .10);
  --track: #4a5763;
  --overlay: rgba(0, 0, 0, .7);
  --shadow: rgba(0, 0, 0, .4);
}
.page.theme-eye {
  --bg: #f2f0e4;
  --surface: #fbfaf0;
  --surface-2: #f5f3e6;
  --surface-3: #eae7d7;
  --text: #353a2e;
  --text-soft: #505744;
  --muted: #7a806e;
  --faint: #9aa08d;
  --line: #dedbc8;
  --line-strong: #5e6651;
  --cell-line: #cdc9b6;
  --accent: #6f8a54;
  --accent-strong: #55713f;
  --accent-ink: #4b6334;
  --accent-soft: #e1ebd1;
  --accent-border: #a9bd8c;
  --outline-border: #a9bd8c;
  --cell: #fbfaf0;
  --given: #eeeada;
  --given-text: #333a2c;
  --peer: #f3f1e3;
  --same: #e8efdc;
  --selected: #dce7c9;
  --unit: #f1f3e7;
  --blue: #5f7893;
  --blue-soft: #e4eaf0;
  --blue-border: #a9bdcb;
  --violet: #8e5c91;
  --violet-soft: #f1eaf2;
  --red: #b94a3e;
  --red-soft: #f4ded8;
  --red-weak: #f3e3df;
  --red-pale: #faf0ed;
  --amber: #9a741f;
  --amber-soft: #f3e9c8;
  --green: #4e7d48;
  --green-soft: #dfead9;
  --green-pale: #eff5e9;
  --track: #a9b29a;
  --overlay: rgba(45, 50, 35, .55);
  --shadow: rgba(59, 64, 45, .15);
}
.mono { font-family: Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
.muted { color: var(--muted); }
.tiny { font-size: 22rpx; line-height: 1.5; }

.hero { display: flex; align-items: center; justify-content: space-between; margin: 6rpx 4rpx 24rpx; }
.brand { display: flex; align-items: center; }
.brand-mark {
  width: 76rpx; height: 76rpx; border-radius: 22rpx;
  background: linear-gradient(145deg, var(--accent), var(--accent-ink));
  color: #ffffff; display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(15, 118, 110, .25);
  margin-right: 18rpx;
}
.brand-copy { display: flex; flex-direction: column; }
.brand-title { font-size: 36rpx; font-weight: 800; letter-spacing: -.5rpx; }
.brand-tagline { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.lang-btn {
  min-width: 116rpx; height: 66rpx; padding: 0 22rpx;
  border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--surface);
  font-size: 24rpx; font-weight: 600; color: var(--text-soft);
  display: flex; align-items: center; justify-content: center;
}

.tabs {
  display: flex; padding: 8rpx; margin-bottom: 26rpx;
  background: var(--surface-3); border: 1rpx solid var(--line); border-radius: 20rpx;
}
.tab {
  flex: 1; text-align: center; padding: 18rpx 8rpx; border-radius: 14rpx;
  font-size: 26rpx; font-weight: 600; color: var(--muted);
}
.tab.active { background: var(--surface); color: var(--text); box-shadow: 0 8rpx 18rpx rgba(23, 32, 41, .08); }

.section-head { padding: 4rpx 6rpx 22rpx; }
.section-title { display: block; font-size: 42rpx; font-weight: 800; letter-spacing: -1rpx; }
.section-sub { display: block; color: var(--muted); font-size: 24rpx; line-height: 1.5; margin-top: 8rpx; }

.segmented {
  display: flex; padding: 6rpx; background: var(--surface-3);
  border: 1rpx solid var(--line); border-radius: 18rpx; margin-bottom: 18rpx;
}
.seg-btn {
  flex: 1; text-align: center; padding: 16rpx 6rpx;
  font-size: 25rpx; font-weight: 600; color: var(--muted); border-radius: 13rpx;
}
.seg-btn.active { background: var(--surface); color: var(--accent-ink); box-shadow: 0 6rpx 14rpx rgba(23, 32, 41, .08); }

.card {
  background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(23, 32, 41, .06);
  padding: 24rpx; margin-bottom: 20rpx;
}
.toolbar { display: flex; align-items: center; flex-wrap: wrap; }
.metric { display: flex; flex-direction: column; margin-right: 28rpx; }
.metric-label { font-size: 20rpx; color: var(--muted); text-transform: uppercase; letter-spacing: 1rpx; font-weight: 700; }
.metric-value { font-size: 30rpx; font-weight: 700; margin-top: 2rpx; }
.toolbar-spacer { flex: 1; }

.board-shell { display: flex; justify-content: center; padding: 18rpx 0 10rpx; }
.board {
  box-sizing: content-box;
  display: flex; flex-wrap: wrap;
  background: var(--surface);
  border: 6rpx solid var(--line-strong);
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 34rpx rgba(23, 32, 41, .13);
}
.cell {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  background: var(--cell);
  border-right: 1rpx solid var(--cell-line);
  border-bottom: 1rpx solid var(--cell-line);
  overflow: hidden;
}
.cell-br { border-right: 4rpx solid var(--line-strong); }
.cell-bb { border-bottom: 4rpx solid var(--line-strong); }
.cell-lc { border-right: none; }
.cell-lr { border-bottom: none; }
.cell.given { background: var(--given); }
.cell.peer { background: var(--peer); }
.cell.same { background: var(--same); }
.cell.selected { background: var(--selected); box-shadow: inset 0 0 0 4rpx var(--accent); z-index: 2; }
.cell.unit-highlight { background: var(--unit); }
.cell.hint-primary { background: var(--blue-soft); box-shadow: inset 0 0 0 4rpx var(--blue); z-index: 3; }
.cell.hint-secondary { background: var(--amber-soft); box-shadow: inset 0 0 0 3rpx var(--amber); z-index: 2; }
.cell.conflict { background: var(--red-soft); }
.cell.wrong { background: var(--red-weak); }
.cell.conflict .cell-value, .cell.wrong .cell-value { color: var(--red); }
.cell-value { color: var(--accent-ink); font-weight: 600; line-height: 1; transform: translateY(-1rpx); }
.cell.given .cell-value { color: var(--given-text); font-weight: 800; }
.notes { display: flex; flex-wrap: wrap; width: 100%; height: 100%; }
.note {
  width: 33.33%; height: 33.33%; display: flex; align-items: center; justify-content: center;
  color: var(--muted); visibility: hidden; line-height: 1;
}
.note.on { visibility: visible; }
.note.cand-color-a { color: var(--blue); font-weight: 800; background: var(--blue-soft); }
.note.cand-color-b { color: var(--violet); font-weight: 800; background: var(--violet-soft); }
.note.cand-pattern { color: var(--blue); font-weight: 800; background: var(--blue-soft); }
.note.cand-eliminate { color: var(--red); font-weight: 800; text-decoration: line-through; background: var(--red-pale); }
.note.cand-place { color: var(--green); font-weight: 800; background: var(--green-pale); }
.hint-line { display: block; text-align: center; color: var(--faint); font-size: 21rpx; margin: 4rpx 0 20rpx; }

.status-line { display: flex; align-items: center; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--faint); margin-right: 14rpx; flex: none; }
.dot.ok { background: var(--green); }
.dot.warn { background: var(--amber); }
.dot.bad { background: var(--red); }
.dot.busy { background: var(--blue); }
.dot.neutral { background: var(--muted); }
.status-title { font-size: 27rpx; font-weight: 700; }
.status-card > .muted { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.5; }
.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }
.meta-row { display: flex; align-items: center; justify-content: space-between; }
.stat-row { display: flex; margin-top: 20rpx; justify-content: space-between; }
.stat-row > view { display: flex; flex-direction: column; }
.stat-value { font-size: 27rpx; font-weight: 700; margin-top: 3rpx; }
.chip {
  display: inline-flex; padding: 7rpx 14rpx; border-radius: 999rpx;
  background: var(--surface-3); color: var(--text-soft); font-size: 21rpx; font-weight: 600;
}
.chip.accent { background: var(--accent-soft); color: var(--accent-ink); }
.chip.tier { background: var(--blue-soft); color: var(--blue); }
.chip.good { background: var(--green-soft); color: var(--green); }

.control-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.toggle {
  display: flex; align-items: center; height: 62rpx; padding: 0 20rpx 0 12rpx;
  border: 1rpx solid var(--line); background: var(--surface-2); border-radius: 999rpx;
  font-size: 23rpx; color: var(--text-soft);
}
.knob { width: 52rpx; height: 32rpx; border-radius: 999rpx; background: var(--track); margin-right: 12rpx; position: relative; }
.knob::after {
  content: ""; position: absolute; width: 26rpx; height: 26rpx; border-radius: 50%;
  top: 3rpx; left: 3rpx; background: var(--surface); box-shadow: 0 2rpx 5rpx rgba(0,0,0,.2);
}
.toggle.on { background: var(--accent-soft); border-color: var(--accent-border); color: var(--accent-ink); }
.toggle.on .knob { background: var(--accent); }
.toggle.on .knob::after { transform: translateX(20rpx); }
.picker {
  padding: 14rpx 18rpx; border: 1rpx solid var(--line); background: var(--surface-2);
  border-radius: 12rpx; font-size: 22rpx; color: var(--muted);
}

.numpad { display: flex; margin: 22rpx 0 6rpx; }
.num-btn {
  flex: 1; height: 82rpx; margin-right: 7rpx;
  border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--surface-2);
  font-size: 34rpx; font-weight: 700; position: relative;
  display: flex; align-items: center; justify-content: center;
}
.num-btn:last-child { margin-right: 0; }
.num-btn.done { opacity: .35; }
.num-btn .count { position: absolute; right: 7rpx; bottom: 4rpx; font-size: 16rpx; color: var(--faint); }

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 72rpx; padding: 0 20rpx; border-radius: 14rpx;
  font-size: 24rpx; font-weight: 650; white-space: nowrap;
}
.btn.small { height: 64rpx; padding: 0 14rpx; font-size: 22rpx; }
.btn.primary { background: var(--accent); color: #ffffff; }
.btn.ghost { background: var(--surface); border: 1rpx solid var(--line); color: var(--text-soft); }
.btn.outline { background: transparent; border: 1rpx solid var(--outline-border); color: var(--accent-ink); }
.btn.full { width: 100%; margin-top: 16rpx; }
.btn[disabled] { opacity: .4; }
.actions { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.actions .btn { flex: 1; margin: 6rpx; min-width: 0; }
.actions.two .btn { width: 48%; flex: none; }
.actions.three .btn { width: 31%; flex: none; }
.row-actions { display: flex; margin-bottom: 18rpx; }
.row-actions .btn { flex: 1; margin-right: 12rpx; }
.row-actions .btn:last-child { margin-right: 0; }

.hint-card { background: var(--blue-soft); border: 1rpx solid var(--blue-border); border-radius: 16rpx; padding: 18rpx; margin-top: 18rpx; }
.hint-head { display: flex; align-items: center; justify-content: space-between; }
.hint-text { display: block; font-size: 23rpx; line-height: 1.6; margin: 14rpx 0; color: var(--text-soft); }
.close { font-size: 40rpx; color: var(--faint); padding: 0 8rpx; line-height: 1; }
.note-card { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); display: flex; flex-direction: column; }

.source-card { display: flex; flex-direction: column; }
.source-input {
  width: 100%; height: 72rpx; margin: 12rpx 0 10rpx; padding: 0 18rpx;
  border: 1rpx solid var(--line); background: var(--surface-2); border-radius: 12rpx;
  font-family: Menlo, Consolas, monospace; font-size: 22rpx; color: var(--text-soft);
}
.warning {
  display: block; margin-top: 14rpx; padding: 14rpx;
  background: var(--amber-soft); color: var(--amber); border-radius: 12rpx; font-size: 22rpx;
}
.playback { padding: 16rpx 20rpx 20rpx; }
.playback slider { margin: 8rpx 0 4rpx; }
.explain-head { display: flex; align-items: flex-start; justify-content: space-between; }
.explain-title { display: block; font-size: 34rpx; font-weight: 750; margin-top: 6rpx; }
.explain-text { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.7; color: var(--text-soft); }
.legend { display: block; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx dashed var(--line); font-size: 21rpx; color: var(--faint); }
.card-title { display: block; font-size: 26rpx; font-weight: 700; margin-bottom: 12rpx; }
.counts { display: flex; flex-wrap: wrap; }
.count-chip { margin: 0 10rpx 10rpx 0; }
.step-scroll { height: 420rpx; }
.step-item { display: flex; align-items: center; padding: 14rpx 12rpx; border-radius: 10rpx; }
.step-item.active { background: var(--accent-soft); }
.step-no { width: 52rpx; text-align: right; margin-right: 14rpx; font-family: Menlo, monospace; font-size: 20rpx; color: var(--faint); }
.step-name { flex: 1; font-size: 23rpx; font-weight: 600; }
.step-tier { font-size: 19rpx; color: var(--muted); margin-left: 10rpx; }

.overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 80;
  background: var(--overlay);
  display: flex; align-items: center; justify-content: center; padding: 32rpx;
}
.modal {
  width: 100%; max-height: 88vh; overflow-y: auto;
  background: var(--surface); border-radius: 26rpx; padding: 30rpx;
  box-shadow: 0 30rpx 70rpx rgba(0,0,0,.25);
}
.modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.modal-title { font-size: 34rpx; font-weight: 750; }
.io-input {
  width: 100%; height: 80rpx; margin: 16rpx 0;
  padding: 0 16rpx; border: 1rpx solid var(--line); border-radius: 12rpx;
  background: var(--surface-2); font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
}
.form-error { display: block; color: var(--red); font-size: 22rpx; margin-bottom: 10rpx; }
.win-modal { text-align: center; padding: 40rpx 30rpx 30rpx; }
.win-mark {
  width: 100rpx; height: 100rpx; margin: 0 auto 18rpx; border-radius: 50%;
  background: var(--green-soft); color: var(--green); font-size: 58rpx;
  display: flex; align-items: center; justify-content: center;
}
.win-title { display: block; font-size: 42rpx; font-weight: 800; margin-bottom: 8rpx; }
.win-stats { display: flex; margin: 26rpx 0; background: var(--surface-2); border-radius: 16rpx; padding: 18rpx 8rpx; }
.win-stats > view { flex: 1; display: flex; flex-direction: column; align-items: center; }


.hero-actions { display: flex; align-items: center; }
.theme-btn { width: 66rpx; min-width: 66rpx; padding: 0; margin-right: 12rpx; font-size: 32rpx; }
.tabs { overflow: hidden; }
.tab { font-size: 23rpx; padding: 16rpx 4rpx; }

.stats-hero { display: flex; flex-direction: column; }
.stats-total { font-size: 64rpx; font-weight: 800; line-height: 1.15; margin: 6rpx 0 10rpx; }
.stats-hero .chip { align-self: flex-start; }
.stats-pair { display: flex; }
.stats-pair .card { flex: 1; }
.stats-pair .card:first-child { margin-right: 16rpx; }
.stat-mini { display: flex; flex-direction: column; }
.stat-big { font-size: 42rpx; font-weight: 750; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.stats-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-top: 1rpx solid var(--line); }
.stats-row-name { font-weight: 600; font-size: 24rpx; }
.stats-row-values { display: flex; flex-direction: column; align-items: flex-end; font-size: 23rpx; }
.stats-recent-row { display: flex; align-items: center; padding: 14rpx 0; border-top: 1rpx solid var(--line); }
.stat-time { margin-left: 16rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.stats-recent-row .tiny { margin-left: auto; }
.empty-state { text-align: center; color: var(--faint); font-size: 23rpx; padding: 24rpx 0; }
.replay-list { display: flex; flex-direction: column; }
.replay-item {
  display: flex; flex-direction: column; text-align: left;
  padding: 16rpx; margin-bottom: 12rpx; border: 1rpx solid var(--line);
  border-radius: 14rpx; background: var(--surface-2);
}
.replay-item.active { background: var(--accent-soft); border-color: var(--accent-border); }
.replay-item-head { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; font-weight: 700; }
.replay-item-meta { margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }
.summary-head { display: flex; align-items: center; justify-content: space-between; }

/* Photo / camera OCR */
.ocr-entry { margin: 12rpx 0 16rpx; padding: 16rpx; border: 1rpx dashed var(--accent-border); border-radius: 14rpx; background: var(--surface-2); }
.ocr-entry .tiny { display: block; margin-top: 8rpx; }
.ocr-modal { max-height: 88vh; overflow-y: auto; }
.ocr-guide { display: flex; flex-direction: column; margin: 14rpx 0; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.ocr-preview { width: 100%; height: 360rpx; margin: 8rpx 0; border-radius: 14rpx; background: #0b1116; }
.ocr-placeholder {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 220rpx; margin: 8rpx 0; border: 1rpx solid var(--line);
  border-radius: 14rpx; background: var(--surface-2); font-size: 52rpx; color: var(--faint);
}
.ocr-placeholder .tiny { margin-top: 8rpx; font-size: 22rpx; }
.ocr-offline { display: block; margin: 8rpx 0; }
.ocr-progress-row { margin: 14rpx 0 4rpx; }
.ocr-progress-row progress { margin-top: 8rpx; width: 100%; }
.center { text-align: center; }
